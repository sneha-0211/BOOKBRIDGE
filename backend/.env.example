# BOOKBRIDGE AI Configuration
# Backend Port and Host
HOST=0.0.0.0
PORT=8000

# Optional AI Vision API (leave blank to use EasyOCR local engine or transparent Demo Mode)
GEMINI_API_KEY=

# Upload size limits (in bytes, default 10MB)
MAX_UPLOAD_BYTES=10485760

# Database path
SQLITE_DB_PATH=bookbridge.db
